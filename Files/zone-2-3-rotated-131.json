      "responsibilities": {
        "1": {
          "where": "从前压位置补防到进攻方2号位",
          "watch": "进攻方2号位的进攻意图",
          "why": "补防回45度解放帮你延误的防守3号位，重置防守链条"
        },
        "2": {
          "where": "横移到罚球线与三分线之间",
          "watch": "中路切入意图（图中进攻方1号位，5号位）",
          "why": "压迫进攻方进行低威胁的回传球（2->1），压迫进攻方2号位给罚球线的进攻方5号位的传球空间，提早感知到中路切入的意图提醒后面的防守4/5号位做应对"
        },
        "3": {
          "where": "先上提靠近三分线45度（不要真提上去，只是靠近，不能真把重心提上去防三分），回防形成后马上下沉，如果进攻方3号位靠近禁区，则绕前防守（解放移动空间，避免进攻方3号位真实作用是挡拆），如果进攻方3号位靠近三分线，则不需要以直接破坏进攻方2->3传球为目的占位，准备进攻方2号位突破后的补防优先级更高",
          "watch": "看底角、短角和持球人底线突破。",
          "why": "3号上提后，强侧不是单人防守，而是边线压迫区域。"
        },
        "4": {
          "where": "稍微从禁区侧面上提到接近进攻方5号位的位置上，",
          "watch": "看遛底，看给罚球线的传球",
          "why": "解放防守5号位给底线补防的空间"
        },
        "5": {
          "where": "从罚球线下沉到更靠近篮筐的位置",
          "watch": "看攻框/前场篮板意向",
          "why": "随时补防进攻方2/3/5号位，沉退护框"
        }
      },
