      "responsibilities": {
        "1": {
          "where": "站在弧顶持球人前方半步到一步，身体略侧向，压迫一侧的突破和传球路线",
          "watch": "这是最上线的防守人，只需要看好最上线的人",
          "why": "压迫一侧空间，逼迫持球人倾向低威胁传球（1->3）或向口袋内持球突破"
        },
        "2": {
          "where": "站在弧顶右侧与罚球线延长线之间，保持能补中也能扑翼侧。",
          "watch": "看球、右侧45度和高位接应。",
          "why": "要在进攻方传球到右侧45度时可以接上防守，传球到罚球线时可以马上夹击，防止进攻方运动能力强的4/5号位在罚球线下球直接攻框"
        },
        "3": {
          "where": "站在1号同侧短角到低位之间，离篮下保持一步半补位距离。",
          "watch": "看同侧底角、篮下切入和球的第一传。",
          "why": "进攻方在成功完成危险传球（1->2）时需要能延误进攻方2号位，给防守方1号位回正位置的时间；\n另外需要关注到底线遛底的情况，需要报出来提醒队友"
        },
        "4": {
          "where": "位置略向篮筐内收，本质是沉退的游击防守人",
          "watch": "看异侧底角、篮下背切和篮板。",
          "why": "视角最好的位置，能观察到场上绝大多数情况，需要随时能和防守2号位形成侧翼的关门，和防守5号位形成对进攻5号位的夹击"
        },
        "5": {
          "where": "站在罚球线附近，贴近罚球线的策应人",
          "watch": "看高位接球、中路切入",
          "why": "防止进攻方5号位接球后转身面框的半截篮，同时压迫进攻方5号位的接球空间，压迫进攻方一号位给五号位的传球质量"
        }
      },
